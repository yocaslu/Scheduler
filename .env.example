# Copie este arquivo para .env e preencha os valores vazios.
# Evite caracteres especiais (@ : / ? #) nas senhas do banco, pois elas entram numa URL.

# ---------- Banco de dados ----------
DB_NAME=scheduler
DB_USER=scheduler
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Usada só ao rodar fora do Docker (pnpm dev, prisma migrate dev).
# No Docker Compose ela é montada a partir das variáveis acima.
DATABASE_URL=mysql://scheduler:SENHA_DO_BANCO@localhost:3306/scheduler

# ---------- Aplicação ----------
# Administrador inicial do painel (login com este e-mail e senha).
ADMIN_USER=admin@exemplo.com
ADMIN_PASSWORD=

# Chave da sessão. Gere com: openssl rand -hex 32
SESSION_SECRET=

# true somente quando o site estiver atrás de HTTPS.
COOKIE_SECURE=false
